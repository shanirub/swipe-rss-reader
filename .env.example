# Copy to .env (never committed) and fill in. Docker Compose reads .env from the repo root.

# Bearer token for the API (at least 32 characters). Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# The same token goes into the Android app's local.properties. Back it up with the keystore.
SWIPE_RSS_API_TOKEN=

# Optional: log level for the jobs and the API (DEBUG, INFO, WARNING, ERROR). Default INFO.
# SWIPE_RSS_LOG_LEVEL=INFO

# Optional: host directory for the on-server database snapshots (default: ../swipe-rss-backups, i.e.
# next to the repo checkout; outside every Docker volume). Must be writable by uid 10001.
# SWIPE_RSS_BACKUP_HOST_DIR=/home/you/swipe-rss-backups
