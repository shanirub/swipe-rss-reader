# Template for android/secrets.properties (git-ignored, never committed):
#   cp secrets.properties.example secrets.properties   then fill in the values.
# app/build.gradle.kts copies them into BuildConfig; the build fails if one is missing.

# The server's SWIPE_RSS_API_TOKEN (from its .env), at least 32 characters.
swiperss.apiToken=

# The API over the tailnet (Tailscale Serve), https only.
swiperss.baseUrl=https://my-first-server.porcupine-celsius.ts.net:8443
